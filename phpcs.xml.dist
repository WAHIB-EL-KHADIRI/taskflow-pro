<?xml version="1.0"?>
<ruleset name="TaskFlow Pro">
    <description>PSR-12, with one documented exception.</description>

    <arg name="colors"/>
    <arg value="sp"/>

    <file>app</file>
    <file>public</file>
    <file>routes</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!--
        PSR-12 says line length SHOULD stay under 120 characters, which is a
        recommendation rather than a requirement. A few route definitions and
        SQL strings read worse when wrapped, so this sniff is silenced. Every
        mandatory PSR-12 rule still fails the build; nothing else is relaxed.
    -->
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>
</ruleset>
