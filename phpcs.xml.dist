<?xml version="1.0"?>
<ruleset name="TaskFlow Pro">
    <description>PSR-12, with one documented exception.</description>

    <file>app</file>
    <file>public</file>
    <file>routes</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!--
            PSR-12 states line length SHOULD stay under 120 characters -- a
            recommendation, not a requirement. A handful of route definitions
            and SQL strings read worse when wrapped, so this specific sniff is
            not enforced. Every PSR-12 rule that is a MUST still fails the
            build; nothing else is relaxed.
        -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
